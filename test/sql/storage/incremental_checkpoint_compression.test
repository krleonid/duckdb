# name: test/sql/storage/incremental_checkpoint_compression.test
# description: Regression tests for incremental checkpoint + compression settings.
# group: [storage]

#   The incremental fast path (FlushTransientSegmentsInPlace) always writes
#   Uncompressed segments — it does NOT re-compress with SET force_compression.
#   This is a documented limitation: force_compression only takes effect when
#   WriteToDisk is used (i.e., when there are updates/deletes in the row group).
#   Tests here pin that behavior so a silent regression shows up as a test failure.

load {TEST_DIR}/inc_ckpt_compress.db

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
SET wal_autocheckpoint = '1TB';

# ────────────────────────────────────────────────────────────────────────────
# §C.1 — force_compression is NOT applied on the incremental flush path.
#
# After a CHECKPOINT, appends fill the last row group's transient tail.
# The incremental path (FlushTransientTail) writes segments Uncompressed —
# it does NOT re-compress with force_compression.  Pin this limitation.
# ────────────────────────────────────────────────────────────────────────────

statement ok
CREATE TABLE t (id INTEGER, val INTEGER);

statement ok
INSERT INTO t SELECT i, i % 10 FROM range(500) tbl(i);

statement ok
CHECKPOINT;

# Enable forced RLE compression BEFORE appending.
statement ok
SET force_compression = 'rle';

# Append-only: new rows land in the existing row group's transient tail.
# The incremental path is taken — force_compression is NOT honored.
statement ok
INSERT INTO t SELECT 1000 + i, (i % 10) FROM range(50) tbl(i);

statement ok
CHECKPOINT;

# The tail segment uses Uncompressed (incremental path does not re-compress).
query I
SELECT compression FROM pragma_storage_info('t')
WHERE segment_type = 'INTEGER' AND persistent = true
ORDER BY row_group_id DESC, segment_id DESC
LIMIT 1;
----
Uncompressed

# Reset.
statement ok
RESET force_compression;

restart

query I
SELECT COUNT(*) FROM t;
----
550

# ────────────────────────────────────────────────────────────────────────────
# §C.2 — WriteToDisk path DOES respect force_compression.
#
# When there are updates, WriteToDisk is used.  In that case force_compression
# is honored for the INTEGER column.
# ────────────────────────────────────────────────────────────────────────────

statement ok
SET force_compression = 'rle';

statement ok
UPDATE t SET val = 99 WHERE id = 0;

statement ok
CHECKPOINT;

# After WriteToDisk with force_compression=rle, at least one INTEGER segment uses RLE.
query I
SELECT COUNT(*) > 0 FROM pragma_storage_info('t')
WHERE segment_type = 'INTEGER' AND compression = 'RLE' AND persistent = true;
----
true

statement ok
RESET force_compression;

restart

query I
SELECT val FROM t WHERE id = 0;
----
99

# ────────────────────────────────────────────────────────────────────────────
# §C.3 — storage_info assertions: segment layout after incremental checkpoint.
#
# After an incremental append-only checkpoint:
#   - All segments are persistent.
#   - No segment reports has_updates = true.
#   - Newly written tail segments use Uncompressed compression.
# ────────────────────────────────────────────────────────────────────────────

statement ok
CREATE TABLE s (x INTEGER);

statement ok
INSERT INTO s SELECT i FROM range(500) tbl(i);

statement ok
CHECKPOINT;

statement ok
INSERT INTO s SELECT 1000 + i FROM range(50) tbl(i);

statement ok
CHECKPOINT;

# All segments are persistent.
query I
SELECT COUNT(*) FROM pragma_storage_info('s') WHERE persistent = false;
----
0

# No segment has pending updates.
query I
SELECT COUNT(*) FROM pragma_storage_info('s') WHERE has_updates = true;
----
0

restart

query I
SELECT COUNT(*) FROM s;
----
550
