# name: test/sql/storage/incremental_checkpoint_append.test
# description: Verify correctness after incremental checkpoint: appending to a persistent table
#              only flushes the new tail segments, not the full column data.
# group: [storage]

load {TEST_DIR}/incremental_checkpoint_append.db

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
SET wal_autocheckpoint = '1TB';

# Create a table with enough rows to span multiple segments per column
statement ok
CREATE TABLE t (id INTEGER, val VARCHAR, n DOUBLE);

statement ok
INSERT INTO t SELECT i, 'row_' || i::VARCHAR, i * 1.5 FROM range(50000) tbl(i);

# Checkpoint: all segments become PERSISTENT
statement ok
CHECKPOINT;

query III
SELECT COUNT(*), MIN(id), MAX(id) FROM t;
----
50000	0	49999

# Append a small batch — these become TRANSIENT tail segments only
statement ok
INSERT INTO t SELECT 50000 + i, 'new_' || i::VARCHAR, (50000 + i) * 1.5 FROM range(100) tbl(i);

query III
SELECT COUNT(*), MIN(id), MAX(id) FROM t;
----
50100	0	50099

# Incremental checkpoint: only the new tail segments should be written
statement ok
CHECKPOINT;

# Reload the database to verify persisted state is correct
restart

query III
SELECT COUNT(*), MIN(id), MAX(id) FROM t;
----
50100	0	50099

# Verify a sample of old rows is intact
query III
SELECT id, val, n FROM t WHERE id = 0;
----
0	row_0	0.0

query III
SELECT id, val, n FROM t WHERE id = 25000;
----
25000	row_25000	37500.0

query III
SELECT id, val, n FROM t WHERE id = 49999;
----
49999	row_49999	74998.5

# Verify newly appended rows are present and correct
query III
SELECT id, val, n FROM t WHERE id = 50000;
----
50000	new_0	75000.0

query III
SELECT id, val, n FROM t WHERE id = 50099;
----
50099	new_99	75148.5

# NULL handling: append NULLs and verify they survive checkpoint
statement ok
INSERT INTO t VALUES (99999, NULL, NULL);

statement ok
CHECKPOINT;

restart

query III
SELECT id, val, n FROM t WHERE id = 99999;
----
99999	NULL	NULL

query I
SELECT COUNT(*) FROM t;
----
50101

# Second incremental cycle: append again after a fresh load
statement ok
INSERT INTO t SELECT 100000 + i, 'c2_' || i::VARCHAR, (100000 + i) * 2.0 FROM range(50) tbl(i);

statement ok
CHECKPOINT;

restart

query III
SELECT COUNT(*), MIN(id), MAX(id) FROM t;
----
50151	0	100049

query II
SELECT id, val FROM t WHERE id = 100049;
----
100049	c2_49

# Regression: UPDATE on a row in a TRANSIENT segment must not be discarded.
# The UPDATE delta lives in the updates-segment, separate from the base segment.
# HasOnlyTransientTail() must detect this and fall back to WriteToDisk().

statement ok
INSERT INTO t VALUES (200000, 'before_update', 0.0);

statement ok
UPDATE t SET val = 'after_update', n = 1.0 WHERE id = 200000;

statement ok
CHECKPOINT;

restart

query III
SELECT id, val, n FROM t WHERE id = 200000;
----
200000	after_update	1.0
